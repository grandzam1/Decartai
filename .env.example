# DECART_API_KEY: Server-only API key for Decart Realtime AI sessions.
# This key is kept strictly server-side to mint short-lived client tokens.
# It is NEVER exposed to the client or bundled in frontend code.
DECART_API_KEY="MY_DECART_API_KEY"

# GEMINI_API_KEY: Optional key for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected at runtime).
APP_URL="MY_APP_URL"
